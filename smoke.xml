<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Hızlı kontrol: her modülün ana akışı. Ayrıntılı senaryolar regresyon.xml'de. -->
<suite name="BVA Smoke" verbose="1" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="com.bvakp.automation.reporting.RetryTransformer"/>
    </listeners>
    <test name="Smoke">

        <classes>
            <class name="com.bvakp.automation.tests.LoginTest">
                <methods>
                    <include name="basariliGirisYapma"/>
                </methods>
            </class>
            <class name="com.bvakp.automation.tests.openData.OpenDataDashboardTest">
                <methods>
                    <include name="istatistikKartlariGoruntuleme"/>
                </methods>
            </class>
            <class name="com.bvakp.automation.tests.openData.OpenDataCreateTest">
                <methods>
                    <include name="kaynakOlusturma"/>
                    <include name="veriSetiOnayaGonderme"/>
                </methods>
            </class>
            <class name="com.bvakp.automation.tests.openData.OpenDataPublishTest">
                <methods>
                    <include name="veriSetiYayinlama"/>
                </methods>
            </class>
            <class name="com.bvakp.automation.tests.publicPortal.PublicOpenDataTest">
                <methods>
                    <include name="aramadaVeriSetiKartiGorunur"/>
                    <include name="apiKayitlariMaskelidir"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>