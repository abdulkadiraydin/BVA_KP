<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="BVA Automation Suite"
       verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.bvakp.automation.reporting.TestListener"/>
    </listeners>

    <test name="BVA Sequential Tests"
          parallel="false">

        <classes>

         <!--   <class name="com.bvakp.automation.tests.openData.OpenDataPublishTest"/> -->
            <class name="com.bvakp.automation.tests.LoginTest"/>
            <class name="com.bvakp.automation.tests.openData.OpenDataCreateTest"/>
            <class name="com.bvakp.automation.tests.openData.OpenDataDashboardTest"/>

        </classes>

    </test>

</suite>